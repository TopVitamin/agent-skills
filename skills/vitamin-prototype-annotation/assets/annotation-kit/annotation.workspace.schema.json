{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vitamin Prototype Annotation Workspace",
  "type": "object",
  "required": [
    "version",
    "inputs"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string"
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "required": [
              "config",
              "scope"
            ],
            "properties": {
              "config": {
                "type": "string",
                "minLength": 1
              },
              "scope": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "order": {
                "type": "number"
              }
            }
          }
        ]
      }
    },
    "runtime": {
      "type": "object",
      "properties": {
        "zIndexBase": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483000
        },
        "initialMode": {
          "type": "string",
          "enum": [
            "preview",
            "annotate"
          ]
        },
        "layout": {
          "type": "string",
          "enum": [
            "drawer",
            "floating"
          ]
        },
        "viewScopeLabels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "drawerWidth": {
          "type": "number",
          "minimum": 280,
          "maximum": 1600
        },
        "hideToolbarWhenEmpty": {
          "type": "boolean",
          "description": "当前页面没有匹配标注时隐藏工具栏与贴边样式，默认 true"
        }
      }
    },
    "output": {
      "type": "string"
    },
    "coverage": {
      "type": "string"
    },
    "htmlOutput": {
      "type": "string"
    },
    "mermaid": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "src": {
          "type": "string"
        },
        "options": {
          "type": "object"
        }
      }
    }
  }
}
